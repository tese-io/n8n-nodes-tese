{
	"name": "n8n-nodes-tese",
	"version": "1.0.0",
	"description": "n8n community nodes for TESE — ESG external API, Tesera AI, OCR, voice entry, anomaly detection, climate risk, platform triggers, webhook triggers, and workflow finalize",
	"license": "MIT",
	"homepage": "https://docs.tese.io/integrations/n8n",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"keywords": [
		"n8n-community-node-package",
		"tese",
		"esg",
		"sustainability"
	],
	"author": {
		"name": "tese.io",
		"email": "dev@tese.io",
		"url": "https://github.com/tese-io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tese-io/n8n-nodes-tese.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "tsx --test tests/**/*.test.ts"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TeseApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Tese/Tese.node.js",
			"dist/nodes/TeseraAi/TeseraAi.node.js",
			"dist/nodes/TeseOcr/TeseOcr.node.js",
			"dist/nodes/TeseVoice/TeseVoice.node.js",
			"dist/nodes/TeseAnomaly/TeseAnomaly.node.js",
			"dist/nodes/TeseClimate/TeseClimate.node.js",
			"dist/nodes/TesePlatformTrigger/TesePlatformTrigger.node.js",
			"dist/nodes/TeseTrigger/TeseTrigger.node.js",
			"dist/nodes/TeseFinalize/TeseFinalize.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"tsx": "^4.19.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
